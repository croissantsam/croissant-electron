{
  "name": "croissant-electron",
  "version": "1.0.26",
  "description": "The ultimate modern Electron boilerplate & CLI generator with React 19, TypeScript, TanStack Router, Tailwind CSS v4, shadcn/ui, and Oxlint.",
  "keywords": [
    "cross-platform",
    "desktop-app",
    "electron",
    "electron-boilerplate",
    "electron-template",
    "electron-vite",
    "oxfmt",
    "oxlint",
    "react",
    "react19",
    "shadcn",
    "shadcn-ui",
    "tailwind-v4",
    "tailwindcss",
    "tanstack-router",
    "typescript"
  ],
  "homepage": "https://github.com/croissantsam/croissant-electron#readme",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croissantsam/croissant-electron.git"
  },
  "bin": {
    "croissant-electron": "./bin/croissant-electron.js"
  },
  "files": [
    ".editorconfig",
    ".github",
    ".gitignore",
    ".npmrc",
    ".oxfmtrc.json",
    ".oxlintrc.json",
    ".vscode",
    "README.md",
    "bin",
    "build",
    "components.json",
    "dev-app-update.yml",
    "electron-builder.yml",
    "electron.vite.config.ts",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "resources",
    "src",
    "tsconfig.json",
    "tsconfig.node.json",
    "tsconfig.web.json"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "format": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "install-electron",
    "start": "electron-vite preview",
    "dev": "install-electron && electron-vite dev",
    "build": "install-electron && npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "install-electron && electron-vite build && electron-builder --mac",
    "build:linux": "install-electron && electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-form-start": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.11",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.10.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
